# mock：不调用模型，用示例剧本和占位画面跑通合成（默认，没有钥匙时也会走这里）
# together：文本和图像都走 Together AI
# openai：OpenAI 兼容接口，可用 TEXT_BASE_URL 指到 DeepSeek 等
AI_PROVIDER=mock

# 留空则跟随 AI_PROVIDER。可以文本用 openai、图像用 together。
TEXT_PROVIDER=
IMAGE_PROVIDER=

# 剧本模型。Together 下不填则用 Qwen/Qwen3-235B-A22B-Instruct-2507
TEXT_MODEL=
TEXT_API_KEY=
# 例：https://api.deepseek.com/v1
TEXT_BASE_URL=

# 图像模型。Together 下不填则用 google/flash-image-2.5
IMAGE_MODEL=
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024

# 本地生图（OpenAI Images 兼容）。不填 LOCAL_IMAGE_BASE_URL 时不会启用。
# 若 IMAGE_PROVIDER 留空且下面的地址有值，画面会自动走 local；显式 IMAGE_PROVIDER=mock 仍是占位图。
# 地址可以写成 http://主机:端口/v1 ，也可以带上 /images/generations。
# IMAGE_PROVIDER=local
# LOCAL_IMAGE_BASE_URL=http://192.168.31.175:7868/v1
# LOCAL_IMAGE_API_KEY=
# LOCAL_IMAGE_MODEL=
# LOCAL_IMAGE_SIZE=1024x1024
# LOCAL_IMAGE_TIMEOUT_MS=300000
# LOCAL_IMAGE_EDITS=false
# 可选：剧本也走局域网里的 OpenAI 兼容文本接口。不填则没有文本钥匙时仍用示例剧本。
# LOCAL_TEXT_BASE_URL=
# LOCAL_TEXT_MODEL=
# LOCAL_TEXT_API_KEY=

# 只填这一把钥匙时，Together 的文本和图像都会用它
TOGETHER_API_KEY=

# 本地 SQLite。不填则使用 ./data/comics.db，启动时自动建表
SQLITE_PATH=

# 以下都可选。不填则：不登录、不限流、图片存在 data/media
S3_UPLOAD_KEY=
S3_UPLOAD_SECRET=
S3_UPLOAD_BUCKET=
S3_UPLOAD_REGION=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
